          <div className={`w-10 h-10 rounded-xl border flex items-center justify-center flex-shrink-0 ${isCloudValidated ? "bg-purple-400/20 border-purple-300/30" : "bg-blue-400/20 border-blue-300/30"}`}>{isCloudValidated ? <BrainCircuit className="w-5 h-5 text-purple-300" /> : <Cpu className="w-5 h-5 text-blue-300" />}</div>
          <div className="flex-1">
            <div className="flex items-center gap-2 mb-1">
              <span className="font-bold text-white text-sm">{isCloudValidated ? "AI Captain · Gevalideerd" : "Lokale SLM · Analyse"}</span>
              {isCloudValidated ? <span className="text-[9px] bg-purple-400/20 text-purple-200 border border-purple-300/25 px-1.5 py-0.5 rounded-full font-bold">CLOUD</span> : <span className="text-[9px] bg-blue-400/20 text-blue-200 border border-blue-300/25 px-1.5 py-0.5 rounded-full font-bold">LOCAL SLM</span>}
            </div>
            <p className="text-xs text-white/65 leading-relaxed">{captainSamenvatting}</p>
          </div>
        </div>
      </GlassCard>
      {kwaliteitsScores && (
        <div className="grid grid-cols-3 gap-2">
          <ScoreBadge label="Ensemble" score={kwaliteitsScores.ensemble} slmScore={!isCloudValidated ? null : slmScores?.ensemble} />
          <ScoreBadge label="AI Model" score={kwaliteitsScores.aiModel} slmScore={!isCloudValidated ? null : slmScores?.aiModel} />
          <ScoreBadge label="Totaal" score={kwaliteitsScores.totaal} slmScore={!isCloudValidated ? null : slmScores?.totaal} />
        </div>
      )}
      {isCloudValidated && analysis._slmValidatie && (
        <GlassCard className="p-4">
          <div className="flex items-center gap-1.5 mb-1.5"><Cloud className="w-3.5 h-3.5 text-purple-300" /><span className="text-[10px] font-bold text-purple-300 uppercase tracking-wide">SLM-validatie door cloud</span></div>
          <p className="text-xs text-white/75 leading-relaxed">{analysis._slmValidatie}</p>
        </GlassCard>
      )}
      {!isCloudValidated && analysis._refinement && (
        <GlassCard className="p-4">
          <div className="flex items-center gap-1.5 mb-1.5"><RefreshCw className="w-3.5 h-3.5 text-green-300" /><span className="text-[10px] font-bold text-green-300 uppercase tracking-wide">Verfijningslus</span><span className="ml-auto text-[10px] text-white/40">ronde 1: {analysis._refinement.round1Issues} → ronde 2: {analysis._refinement.round2Issues}</span></div>
          <p className="text-xs text-white/75 leading-relaxed mb-2">{analysis._refinement.correctionsReport}</p>
          {analysis._refinement.corrections.length > 0 && (
            <div className="space-y-1.5 mt-2">
              {analysis._refinement.corrections.slice(0, 6).map((c, i) => (<div key={i} className="flex items-start gap-1.5 text-[11px] bg-white/8 rounded-lg px-2.5 py-1.5"><CheckCircle2 className="w-3 h-3 text-green-300 flex-shrink-0 mt-0.5" /><div><span className="text-white/80 font-medium">{c.dag}</span><span className="text-white/45 ml-1.5">{c.detail}</span></div></div>))}
              {analysis._refinement.corrections.length > 6 && (<p className="text-[10px] text-white/35 pl-1">+{analysis._refinement.corrections.length - 6} meer correcties</p>)}
            </div>
          )}
        </GlassCard>
      )}
      {modelVerificatie?.length > 0 && (
        <CollapsibleSection title="Model-afwijkingen" icon={AlertTriangle} iconColor="text-amber-300" count={modelVerificatie.length}>
          {modelVerificatie.map((item, i) => (<div key={i} className={`rounded-xl border px-3 py-2.5 text-xs ${ernstColor[item.ernst] || ernstColor.middel}`}><div className="flex items-center gap-1.5 mb-1 font-semibold">{ernstIcon[item.ernst] || ernstIcon.middel}<span>{item.dag}</span><span className="ml-auto opacity-60 capitalize">{item.ernst}</span></div><p className="opacity-80">{item.probleem}</p>{item.aanbeveling && <p className="mt-1 opacity-55 italic">{item.aanbeveling}</p>}</div>))}
        </CollapsibleSection>
      )}
      {foutDetectie?.length > 0 && (
        <CollapsibleSection title="Gedetecteerde fouten" icon={Zap} iconColor="text-red-300" count={foutDetectie.length}>
          {foutDetectie.map((item, i) => (<div key={i} className={`rounded-xl border px-3 py-2.5 text-xs ${ernstColor[item.ernst] || ernstColor.hoog}`}><div className="flex items-center gap-1.5 mb-1 font-semibold">{ernstIcon[item.ernst] || ernstIcon.hoog}<span>{item.dag}</span></div><p className="opacity-80">{item.fout}</p>{item.correctie && <p className="mt-1 opacity-55 italic">→ {item.correctie}</p>}</div>))}
        </CollapsibleSection>
      )}
      {patroonAnalyse && (<CollapsibleSection title="Patroonanalyse" icon={TrendingUp} iconColor="text-blue-300"><p className="text-xs text-white/65 leading-relaxed">{patroonAnalyse}</p></CollapsibleSection>)}
      {verbeteringen?.length > 0 && (
        <CollapsibleSection title="Modelverbeteringen" icon={Star} iconColor="text-yellow-300" count={verbeteringen.length}>
          {verbeteringen.map((v, i) => (<div key={i} className="rounded-xl border border-white/15 bg-white/8 px-3 py-2.5"><div className="flex items-center gap-1.5 mb-1"><span className={`text-[10px] font-bold uppercase tracking-wide ${prioriteitColor[v.prioriteit] || "text-white/50"}`}>{v.prioriteit}</span><span className="text-xs font-semibold text-white">{v.titel}</span></div><p className="text-xs text-white/55 leading-relaxed">{v.beschrijving}</p></div>))}
        </CollapsibleSection>
      )}
    </motion.div>
  );
}

export default function AICaptainPanel({ localAnalysis, cloudValidation, cloudLoading, cloudPhase, onCloudValidate }) {
  if (cloudLoading) return <CloudLoading activePhase={cloudPhase || 1} />;
  if (!localAnalysis) {
    return (<div className="mt-4 flex flex-col items-center gap-4 py-8"><div className="w-16 h-16 rounded-full bg-blue-400/15 border border-blue-300/25 flex items-center justify-center"><Cpu className="w-8 h-8 text-blue-300" /></div><p className="text-white/70 text-xs text-center max-w-xs">Lokale SLM-analyse wordt voorbereid...</p></div>);
  }
  if (cloudValidation && !cloudValidation._cloudError) {
    const slmScores = localAnalysis?.kwaliteitsScores;
    const isCloudValidated = cloudValidation._source === "cloud-validated";
    return (<><AnalysisContent analysis={cloudValidation} isCloudValidated={isCloudValidated} slmScores={slmScores} /><button onClick={onCloudValidate} className="mt-3 mx-auto flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white/70 font-semibold text-sm px-5 py-2.5 rounded-2xl transition-all active:scale-95"><RefreshCw className="w-4 h-4" /> Opnieuw valideren</button></>);
  }
  if (cloudValidation?._cloudError) {
    return (<><AnalysisContent analysis={localAnalysis} isCloudValidated={false} /><GlassCard className="mt-3 p-4 flex items-start gap-3"><CloudOff className="w-5 h-5 text-amber-300 flex-shrink-0 mt-0.5" /><div><p className="text-xs font-semibold text-amber-200 mb-0.5">Cloud-validatie niet beschikbaar</p><p className="text-[11px] text-white/55 leading-relaxed">De lokale SLM-analyse hierboven is volledig bruikbaar. Cloud-validatie via Claude is momenteel niet beschikbaar.</p><button onClick={onCloudValidate} className="mt-2 flex items-center gap-1.5 bg-white/10 hover:bg-white/20 border border-white/20 text-white/70 font-semibold text-xs px-3 py-1.5 rounded-xl transition-all active:scale-95"><RefreshCw className="w-3.5 h-3.5" /> Opnieuw proberen</button></div></GlassCard></>);
  }
  return (<><AnalysisContent analysis={localAnalysis} isCloudValidated={false} /><div className="mt-4"><GlassCard className="p-4 flex flex-col items-center gap-3"><div className="w-12 h-12 rounded-full bg-purple-400/15 border border-purple-300/25 flex items-center justify-center"><Cloud className="w-6 h-6 text-purple-300" /></div><div className="text-center space-y-1"><p className="text-white font-semibold text-sm">Cloud-validatie</p><p className="text-white/60 text-xs leading-relaxed max-w-xs">De lokale SLM-analyse hierboven draait volledig in je browser. Laat Claude (cloud) deze valideren voor een second opinion en bijgestelde scores.</p></div><button onClick={onCloudValidate} className="flex items-center gap-2 bg-purple-500/25 hover:bg-purple-500/35 border border-purple-300/30 text-purple-200 font-semibold text-sm px-5 py-2.5 rounded-2xl transition-all active:scale-95"><Cloud className="w-4 h-4" /> Cloud-validatie starten</button><p className="text-white/45 text-[10px] text-center">Claude Sonnet + Opus · ca. 5-8 minuten</p></GlassCard></div></>);
