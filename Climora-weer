export default function HourlyPanel({ hourlyData, selectedDate }) {
  if (!hourlyData || hourlyData.length === 0) return null;
  const now = new Date();
  const nowMinutes = now.getHours() * 60 + now.getMinutes();
  const dayData = hourlyData.filter(h => h.date === selectedDate);
  if (dayData.length === 0) return null;
  const isSelectedToday = selectedDate === format(now, "yyyy-MM-dd");
  let currentIdx = -1;
  if (isSelectedToday) {
    let minDiff = Infinity;
    dayData.forEach((h, i) => { const diff = Math.abs(h.minutes - nowMinutes); if (diff < minDiff) { minDiff = diff; currentIdx = i; } });
  }

  return (
    <div className="mt-4">
      <div className="flex items-center gap-2 mb-3 px-1">
        <span className="text-xs font-semibold text-white/80">{isSelectedToday ? "⏱ Vandaag — per halfuur" : "🕐 Uurverwachting"}</span>
        {isSelectedToday && currentIdx >= 0 && (
          <span className="text-[10px] bg-white/15 text-white/80 px-2 py-0.5 rounded-full border border-white/20">Nu: {dayData[currentIdx].temp}°{dayData[currentIdx].feelsLike != null ? ` · voelt als ${dayData[currentIdx].feelsLike}°` : ""} · {dayData[currentIdx].weatherLabel}</span>
        )}
      </div>
      <div className="space-y-0.5">
        {dayData.map((slot, i) => {
          const isCurrent = i === currentIdx;
          const isPast = isSelectedToday && slot.minutes < nowMinutes - 30;
          const Icon = slot.icon;
          return (
            <motion.div key={slot.time} initial={{ opacity: 0, x: -8 }} animate={{ opacity: 1, x: 0 }} transition={{ duration: 0.2, delay: Math.min(i * 0.01, 0.3) }}>
              <GlassCard isHighlighted={isCurrent} className={`px-3 py-1.5 ${isPast ? "opacity-40" : ""}`}>
                <div className="flex items-center gap-2.5">
                  <span className={`text-sm font-mono w-11 flex-shrink-0 ${isCurrent ? "text-white font-bold" : "text-white/80"}`}>{slot.timeLabel}</span>
                  <Icon className={`w-5 h-5 flex-shrink-0 ${slot.color} ${isPast ? "" : "drop-shadow-sm"}`} />
                  <span className="text-xs text-white/75 flex-1 truncate">{slot.weatherLabel}</span>
                  <span className="text-xs text-blue-200/90 flex items-center gap-0.5 flex-shrink-0"><Droplets className="w-3 h-3" />{slot.precipProb}%</span>
                  <span className="text-xs text-white/65 flex items-center gap-0.5 flex-shrink-0 w-14 justify-end"><Wind className="w-3 h-3" />{slot.wind} km/u</span>
                  <div className="text-right flex-shrink-0">
                    <span className={`text-sm font-bold ${isCurrent ? "text-white" : "text-white/80"}`}>{slot.temp}°</span>
                    {slot.feelsLike != null && slot.feelsLike !== slot.temp && (<div className="text-[10px] text-white/55">v.{slot.feelsLike}°</div>)}
                  </div>
                </div>
                {isCurrent && (<div className="absolute left-0 top-0 bottom-0 w-0.5 bg-white/60 rounded-full" />)}
              </GlassCard>
            </motion.div>
          );
        })}
      </div>
    </div>
  );
}
